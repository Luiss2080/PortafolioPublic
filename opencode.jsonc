{
  "$schema": "https://opencode.ai/config.json",

  // Servidores MCP del proyecto (el servidor "playwright" se hereda de la config global)
  "mcp": {
    // Documentación en vivo de React, Tailwind, Framer Motion, lucide-react
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    // Auditorías en vivo: performance, accesibilidad WCAG, SEO, consola
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  },

  // Rutas de skills del proyecto (openspec + marketing + skills existentes)
  "skills": {
    "paths": [".opencode/skills", ".agents/skills"]
  },

  "instructions": ["AGENTS.md"]
}
